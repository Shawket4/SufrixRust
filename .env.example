# Copy to .env and fill in real values.
# NEVER commit .env to version control.
#
# Docker note: DATABASE_URL must use host.docker.internal (not localhost)
# when the backend runs in a container on the VPS.
# Example: postgres://madar:<password>@host.docker.internal:5432/madar

DATABASE_URL=postgres://madar:<password>@host.docker.internal:5432/madar

# Local dev only (docker-compose.dev.yml overrides DATABASE_URL with this):
DEV_DATABASE_URL=postgres://madar:<password>@host.docker.internal:5432/madar_dev

# Must be a long random string — generate with: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>

RUST_LOG=info
BIND_ADDR=0.0.0.0:8081
UPLOADS_DIR=./uploads
UPLOADS_BASE_URL=https://madar-pos.cloud/api/uploads
# Recipe-step animations. Shipped inside the image; served at /static/step-animations.
STEP_ANIMATIONS_DIR=./static/step-animations

# WhatsApp gateway (container-network address set by docker-compose.yml;
# WHATSAPP_AUTH_HEADER must match WA_AUTH_TOKEN in the whatsapp container)
WHATSAPP_AUTH_HEADER=<shared-secret>
WHATSAPP_SESSION=main

# Shlink short-URL service (SHLINK_BASE_URL overridden by compose to http://shlink:8080;
# SHLINK_API_KEY is also used by the Shlink container as INITIAL_API_KEY)
SHLINK_API_KEY=<your-shlink-api-key>

# Origins of the two PUBLIC apps. These are separately built, separately
# deployed bundles on their own hosts — NOT paths under the dashboard. The apex
# domain serves the dashboard SPA, which has no `/order/{org}` route at all, so
# pointing either of these at it produces QR cards and WhatsApp links that land
# on a blank page. Check these against what nginx actually serves.
#
#   PUBLIC_ORDER_BASE_URL        -> ordering + delivery tracking (QR cards)
#   PUBLIC_RESERVATIONS_BASE_URL -> table bookings (QR cards + the guest's
#                                   manage link in WhatsApp confirmations;
#                                   unset drops the link from the message and
#                                   503s the booking QR endpoints)
PUBLIC_ORDER_BASE_URL=https://order.madar-pos.cloud
PUBLIC_RESERVATIONS_BASE_URL=https://reservations.madar-pos.cloud

# Translation (optional — leave blank to disable auto-translation)
GOOGLE_TRANSLATE_API_KEY=
SUPPORTED_LANGUAGES=en,ar

# PRODUCTION: keep false. Swagger UI exposes the full API surface unauthenticated.
MADAR_ENABLE_SWAGGER_UI=false

# ── AI analytics chat (the "Ask" module) ────────────────────────────────────
# Which LLM backend to use: "gemini" or "groq". Leave blank to auto-pick
# whichever key below is set (Gemini first). An explicit value with a missing
# key just disables the feature — no silent fallback.
AI_PROVIDER=gemini
# Gemini 2.5 Flash (Google AI Studio key).
GEMINI_API_KEY=
# Groq (OpenAI-compatible, runs Llama et al. very fast). Model is optional.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Error reporting (self-hosted Sentry) ────────────────────────────────────
# Leave SENTRY_DSN blank to disable entirely: no client is created, nothing is
# sent, and the server behaves exactly as it did before Sentry existed (the
# normal state for dev, CI, and the fuzz/load harnesses).
# Request bodies, cookies, query strings and any field matching the PII
# denylist in src/observability.rs are stripped before an event leaves the
# process — see the published privacy policy.
SENTRY_DSN=
# Defaults to "production" when blank; set to "staging"/"dev" on other boxes so
# their events do not land in the production issue stream.
SENTRY_ENVIRONMENT=
# Defaults to madar-rust@<crate version>. Set to the deployed git SHA/tag if you
# want per-deploy issue grouping and regression detection.
SENTRY_RELEASE=
# Performance tracing, 0.0–1.0. Off by default: the Sentry instance shares the
# VPS with Postgres and the backend.
SENTRY_TRACES_SAMPLE_RATE=0.0
